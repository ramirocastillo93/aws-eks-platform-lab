# Copy to runtime.env (ignored by Git) and replace every placeholder.
# Keep URL-reserved characters in passwords percent-encoded.
APP_SECRET=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
DATABASE_URL=postgresql://docmost_app:REPLACE_URL_ENCODED_PASSWORD@REPLACE_WITH_RDS_HOST:5432/docmost?sslmode=require
REDIS_URL=rediss://:REPLACE_URL_ENCODED_VALKEY_AUTH_TOKEN@REPLACE_WITH_VALKEY_HOST:6379
